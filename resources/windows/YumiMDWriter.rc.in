#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/resources/windows/YumiMDWriter.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Based on KDE Ghostwriter; GPL-3.0-or-later\0"
            VALUE "FileDescription", "YumiMDWriter - Markdown Editor\0"
            VALUE "FileVersion", "@PROJECT_VERSION@ YumiMDWriter Windows Edition 1.0\0"
            VALUE "InternalName", "YumiMDWriter\0"
            VALUE "LegalCopyright", "Copyright 2014-@CURRENT_YEAR@ The ghostwriter team\0"
            VALUE "OriginalFilename", "YumiMDWriter.exe\0"
            VALUE "ProductName", "YumiMDWriter\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@ YumiMDWriter Windows Edition 1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
